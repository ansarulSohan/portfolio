# Copy to .env.local for local dev. In production, set these as Coolify env vars.
# Never put real values in this file: it is committed.

# MongoDB Atlas connection string (dedicated user with readWrite on the portfolio DB only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/portfolio?retryWrites=true&w=majority

# Session signing secret: generate with `openssl rand -base64 32`
AUTH_SECRET=

# Initial admin account, used by the seed script only when no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# S3-compatible bucket (Cloudflare R2, AWS S3, MinIO)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=portfolio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves bucket objects (used by next/image)
S3_PUBLIC_URL=https://cdn.example.com

# Public URL of the site (sitemap, Open Graph, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
